# Neon Postgres. Pooled URL for the app, direct URL for migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth
BETTER_AUTH_SECRET=          # 32+ random bytes
BETTER_AUTH_URL=http://localhost:3107
# AI provider. Empty = labelled keyword-matching (FAQ) mode, never presented as a model.
AI_PROVIDER=
AI_MODEL=
# Email. Empty = dry run (logged on the server, nothing sent).
RESEND_API_KEY=
EMAIL_FROM=
# Dev seed (fictional demo accounts use the .test domain)
DEMO_EMAIL=owner@glowstudio.test
DEMO_PASSWORD=
NEXT_PUBLIC_BRAND_NAME=Reception
