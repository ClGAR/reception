# Neon Postgres. Pooled URL for the app, direct URL for migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Restricted role for the staff app (row-level security). Written by: npx tsx --env-file=.env scripts/setup-app-role.mts
# Required in production; without it in dev, tenant queries run as the owner (no RLS).
DATABASE_URL_APP=
# Better Auth
BETTER_AUTH_SECRET=          # 32+ random bytes
BETTER_AUTH_URL=http://localhost:3107
# AI provider. Empty = labelled keyword-matching (FAQ) mode, never presented as a model.
# AI_PROVIDER=openai-compatible  (any OpenAI-compatible endpoint, e.g. a local router)  or  anthropic
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=                 # openai-compatible only, e.g. http://127.0.0.1:31415/v1
AI_API_KEY=
# Email (Resend). Empty = dry run (logged on the server, nothing sent). EMAIL_FROM needs a verified domain,
# e.g. "Reception <bookings@yourdomain.ph>". *.test / example.* addresses are never delivered.
RESEND_API_KEY=
EMAIL_FROM=
# Background jobs (Inngest). Production: keys from app.inngest.com. Local: `npx inngest-cli@latest dev` + INNGEST_DEV=1.
# All empty = notifications are delivered inline right after each change (no retries/sweep/reminders).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=
# Dev seed (fictional demo accounts use the .test domain)
DEMO_EMAIL=owner@glowstudio.test
DEMO_PASSWORD=
NEXT_PUBLIC_BRAND_NAME=Reception
